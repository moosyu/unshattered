.base-container {
    width: 176;
    height: 166;
    padding-all: 4;
    // texture location, sprite region (x, y, width, height), border size (for nine-splice) left -> bottom
    background: sprite(unshattered:textures/gui/unshattered_base_gui.png, 16, 0, 16, 16, 4, 4, 4, 4);
    scroller-view-mode: vertical;
}

.crafting-screen-container {
    background: sprite(unshattered:textures/gui/crafting_screen.png);
    gap: 13;
}

.crafting-container {
    flex-direction: row;
    align-items: center;
}

.inventory-container, .crafting-screen-container {
    padding: 7 4 4 7;
}

item-slot {
    background: sprite(unshattered:textures/gui/unshattered_base_gui.png, 32, 11, 18, 18);
}

.armour-slots-container {
    margin: 2 0 4 2;
    flex-direction: column;
}

.inventory-slots-container {
    flex-direction: row;
}

.hotbar-slots-container {
    flex-direction: row;
    margin-top: 4;
}

.scrollable-container {
    height: 158;
}

.base-title {
    padding-all: 2;
    margin-bottom: 8;
    font-size: 12;
}

label {
    margin: 3 0 3 0;
}

// tab
.tab {
    background: sprite(unshattered:textures/gui/unshattered_base_gui.png, 32, 0, 32, 11, 3, 10, 3, 0);
}

.tab-opened {
    width: 32;
    height: 32;
}

.tab-closed {
    width: 32;
    height: 18;
}

.__tab-view_tab_content_container__ {
  background: sprite(unshattered:textures/gui/unshattered_base_gui.png, 16, 0, 16, 16, 4, 4, 4, 4);
  width: 176;
  height: 166;
  // just to try to position the menu more like the vanilla inventory
  margin-bottom: 30;
}

tab:host {
  base-background: sprite(unshattered:textures/gui/unshattered_base_gui.png, 32, 0, 32, 11, 3, 10, 3, 0);
  hover-background: sprite(unshattered:textures/gui/unshattered_base_gui.png, 32, 0, 32, 11, 3, 10, 3, 0);
  pressed-background: sprite(unshattered:textures/gui/unshattered_base_gui.png, 32, 0, 32, 11, 3, 10, 3, 0);
  width: 32;
  clip: scissor;
}

.tab-icon {
    width: 16;
    height: 16;
    top: 12;
    left: 8;
}

//scroller view
scroller-vertical:host {
    width: 14;
}

.__scroller_scroll_container__ {
    background: built-in(ui-ore:RECT2);
}

scroller-vertical .__scroller_scroll_bar__ {
    base-background: sprite(unshattered:textures/gui/unshattered_base_gui.png, 0, 0, 13, 14, 2, 2, 2, 3);
    hover-background: sprite(unshattered:textures/gui/unshattered_base_gui.png, 0, 16, 13, 14, 2, 2, 2, 3);
    pressed-background: sprite(unshattered:textures/gui/unshattered_base_gui.png, 0, 16, 13, 14, 2, 2, 2, 3) color(#ddd);
}

.__scroller_head_button__ {
    display: none;
}

.__scroller_tail_button__ {
    display: none;
}

scroller-view {
    scroller-view-margin: 10;
}

// for the content area of the scroller
.__scroller_view_view-port__ {
    background: empty;
    padding-all: 2;
}

.__scroller_view_horizontal-scroller__ {
    height: 8;
    margin-top: 2;
}

.__scroller_view_vertical-scroller__ {
    width: 8;
    margin-left: 2;
}

progress-bar:host {
    height: 7;
}

.__progress-bar_bar-container__ {
    background: sprite(unshattered:textures/gui/unshattered_base_gui.png, 16, 16, 5, 5, 2, 2, 2, 2);
    padding-all: 0;
}

.__progress-bar_bar__ {
    background: sprite(unshattered:textures/gui/unshattered_base_gui.png, 21, 16, 5, 5, 2, 2, 2, 2);
}

.__progress-bar_label__ {
    text: empty;
}

// button
button:host > .__white_icon__ { //icon?
  color: #222;
}

button.__white_icon__ > .__icon__ { //icon?
  color: #222;
}

button:host .__button_text__ {
  color: #222;
  text-color: #222;
  text-shadow: false;
}

button:host,
tag-field:host button {
  base-background: built-in(ui-ore:BTN_DEFAULT);
  hover-background: built-in(ui-ore:BTN_PRESSED);
  pressed-background: built-in(ui-ore:BTN_PRESSED) color(#dddddd);
  padding-all: 2;
  padding-bottom: 4;
}

.back-button {
    width: 16;
    height: 16;
    base-background: sprite(unshattered:textures/gui/unshattered_base_gui.png, 22, 32, 16, 16);
    hover-background: sprite(unshattered:textures/gui/unshattered_base_gui.png, 22, 32, 16, 16) color(#dddddd);
    pressed-background: sprite(unshattered:textures/gui/unshattered_base_gui.png, 22, 32, 16, 16) color(#dddddd);
}